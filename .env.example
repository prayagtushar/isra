# Copy to .env. The API and retrieval lib read ISRA_-prefixed vars; ingest reads plain DATABASE_URL.

# Database, used by the API and the retrieval library.
ISRA_DATABASE_URL=postgresql://isra:isra@localhost:5432/isra
# Used by the ingest job (apps/ingest). Point at the same database.
DATABASE_URL=postgresql://isra:isra@localhost:5432/isra

# LLM (OpenRouter), required for POST /chat.
ISRA_OPENROUTER_API_KEY=sk-or-...
# A ":free" model to stay at $0; the suffix is required and the free roster rotates.
ISRA_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Langfuse tracing (optional). Disabled unless both keys are set.
ISRA_LANGFUSE_PUBLIC_KEY=
ISRA_LANGFUSE_SECRET_KEY=
ISRA_LANGFUSE_HOST=https://cloud.langfuse.com

# Evals, only for `bun run eval`. Reuses ISRA_OPENROUTER_API_KEY above.
ISRA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Web app, server-side only. Base URL of the deployed API, no trailing slash.
API_URL=http://localhost:8000

# Web session secret (>=32 chars; used to sign session cookies)
AUTH_SECRET=change-me-to-a-random-string-at-least-32-characters

# Optional: password reset email (SMTP). Leave unset to print reset links to logs in dev.
ISRA_RESET_URL_BASE=http://localhost:3000/reset-password
ISRA_SMTP_HOST=
ISRA_SMTP_PORT=587
ISRA_SMTP_USER=
ISRA_SMTP_PASS=
ISRA_SMTP_FROM=noreply@isra.dev

# Optional: comma-separated origins allowed for direct API calls (default * in dev)
ISRA_CORS_ORIGINS=*
